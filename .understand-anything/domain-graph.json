  "domains": [
    {
      "id": "domain:model-quantization",
      "name": "模型量化",
      "description": "模型量化是 Quark 的核心业务领域，负责将深度学习模型的权重和激活从高精度浮点数（FP32/FP16）转换为低精度整数（INT8/INT4 等）或低精度浮点数，在保持模型精度的前提下显著减少模型体积与推理延迟。涵盖 PyTorch 后端（假量化模块、张量量化、量化神经网络层）和 ONNX 后端（静态量化器、动态量化器、MatMulNBits 量化器）两大路径。",
      "flows": [
        {
          "id": "flow:model-quantization-torch-static",
          "name": "PyTorch 静态量化流程",
          "description": "通过假量化（Fake Quantization）方式对 PyTorch 模型执行静态后训练量化，包括配置量化策略、替换层为量化模块、执行量化图追踪与优化、生成量化模型。",
          "steps": [
            {
              "order": 1,
              "description": "构建量化配置：定义目标张量和层的量化数据类型、观察器策略、舍入方式等参数（数据类型涵盖 Int2-Int32、FP4-FP16、MX 格式）",
